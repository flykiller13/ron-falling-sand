#version 430 core

layout (local_size_x = 1, local_size_y = 1) in;// Process 16x16 blocks

struct Cell {
    int type;
};

layout(std430, binding = 0) buffer InputBuffer { Cell cells[]; } inputGrid;
layout(std430, binding = 1) buffer OutputBuffer { Cell cells[]; } outputGrid;

uniform int width;
uniform int height;
uniform int pass;// 0 for even workgroups, 1 for odd workgroups
uniform bool debugWorkgroupBorders;// Toggle for debug visualization

bool isInBounds(int x, int y) {
    return x >= 0 && x < width && y >= 0 && y < height;
}

bool canMoveTo(int x, int y) {
    if (!isInBounds(x, y)) return false;
    int idx = y * width + x;
    return inputGrid.cells[idx].type == 0;
}

void moveTo(int fromX, int fromY, int toX, int toY) {
    if (!isInBounds(fromX, fromY) || !isInBounds(toX, toY)) return;

    int fromIdx = fromY * width + fromX;
    int toIdx = toY * width + toX;

    int fromType = inputGrid.cells[fromIdx].type;
    int toType = inputGrid.cells[toIdx].type;

    outputGrid.cells[toIdx].type = fromType;
    outputGrid.cells[fromIdx].type = toType;
}

// Debug function: Check if current thread is at workgroup border
bool isAtWorkgroupBorder() {
    ivec2 localID = ivec2(gl_LocalInvocationID.xy);
    // Check if we're at the edge of the 16x16 workgroup
    return localID.x == 0 || localID.x == 15 || localID.y == 0 || localID.y == 15;
}

